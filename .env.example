# Local development / production-style simulation. Never commit real values.
JARVIS_ENV=development
GEMINI_API_KEY=<set-in-secret-store>

# Set these to long random values to exercise authenticated local mode.
# In production use distinct admin and agent tokens.
JARVIS_ADMIN_TOKEN=<generate-a-long-random-token>
JARVIS_AGENT_TOKEN=<generate-a-different-long-random-token>

# The Cloud uses this directory for tasks, devices, activity, memory, and uploads.
# Leave unset locally to preserve the historical project paths.
JARVIS_DATA_DIR=
JARVIS_CORS_ORIGINS=
PORT=8080

# Optional Cloud model overrides. Keep provider credentials server-side.
JARVIS_PLANNER_MODEL=gemini-flash-latest
JARVIS_LIVE_MODEL=gemini-3.8-live
JARVIS_LIVE_API_VERSION=v1beta

# Self-engineering is disabled by default. Enable only for an explicitly
# supervised local engineering session.
JARVIS_SELF_ENGINEERING_ENABLED=0

# Mac Agent settings
JARVIS_CLOUD_URL=https://jarvis.jarvis.blitz.cloud
JARVIS_AGENT_ID=mac-main
# Reuse the agent token above when starting mac_agent.py.
JARVIS_AGENT_POLL_SECONDS=3
