# ============================================================
# STARTUP
# ============================================================

@app.on_event(
    "startup"
)
async def startup_event():

    print()

    print("=" * 70)

    print(
        "☁️  JARVIS CLOUD STARTED"
    )

    print("=" * 70)

    print(
        f"Actions: "
        f"{len(action_registry.names())}"
    )

    print(
        f"Persistent tasks: "
        f"{len(tasks)}"
    )

    print(
        f"Task storage: "
        f"{TASK_FILE}"
    )

    print("=" * 70)
