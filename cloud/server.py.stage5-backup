# CANCEL TASK
# ============================================================

@app.post(
    "/tasks/{task_id}/cancel"
)
async def cancel_task(
    task_id: str,
):

    task = tasks.get(
        task_id
    )

    if task is None:

        raise HTTPException(
            status_code=404,
            detail="Task not found",
        )

    if task.get(
        "status"
    ) in {

        "completed",

        "failed",

        "cancelled",

    }:

        raise HTTPException(
            status_code=409,
            detail="Task is already finished.",
        )

    task["status"] = (
        "cancelled"
    )

    task["lease_expires_at"] = None
    task["recovery_reason"] = "Cancelled by user."

    task["completed_at"] = (
        current_time()
    )

    save_tasks()

    return task


