# ============================================================
# CREATE TASK
# ============================================================

@app.post("/tasks")
async def create_task(
    request: TaskRequest,
):

    task_id = str(
        uuid.uuid4()
    )

    print()
    print("=" * 60)

    print(
        f"[JARVIS Cloud] "
        f"New task: {request.goal}"
    )

    print(
        f"[JARVIS Cloud] "
        f"Target device: {request.device}"
    )

    print("=" * 60)

    task = {

        "id": task_id,

        "goal": request.goal,

        "device": request.device,

        "status": "planning",

        "plan": None,

        "result": None,

        "error": None,

        "created_at": current_time(),

        "planned_at": None,

        "claimed_at": None,

        "completed_at": None,

        "claimed_by": None,

        # Recovery metadata.  Kept with the task so Cloud restarts preserve
        # the ownership and retry decision rather than guessing from logs.
        "attempt_count": 0,
        "lease_id": None,
        "lease_expires_at": None,
        "heartbeat_at": None,
        "completed_by_lease_id": None,
        "recovery_reason": None,
        "recovered_at": None,
        "planning_attempt_count": 1,
        "planning_started_at": current_time(),
        "blocked_recovery_attempt_count": 0,
        "blocked_recovery_history": [],
    }

    tasks[task_id] = task

    save_tasks()

    try:

        plan = planner.plan(
            request.goal
        )

        plan_data = plan_to_data(plan)

        task["plan"] = plan_data

        if request.device == "cloud":

            task["status"] = "planned"

        else:

            task["status"] = "queued"

        task["planned_at"] = (
            current_time()
        )

        save_tasks()

        print(
            "[JARVIS Cloud] "
            "Plan generated successfully."
        )

        return task

    except Exception as exc:

        # Keep transient planning failures recoverable.  The background worker
        # retries with a bounded budget and eventually marks it failed.
        task["status"] = "planning"

        task["error"] = str(
            exc
        )

        save_tasks()

        print(
            f"[JARVIS Cloud] "
            f"Planning failed: {exc}"
        )

        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )


