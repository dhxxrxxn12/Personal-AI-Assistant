# ============================================================
# CLAIM TASK
# ============================================================

@app.post(
    "/tasks/{task_id}/claim"
)
async def claim_task(
    task_id: str,
    request: TaskClaimRequest,
):

    task = tasks.get(
        task_id
    )

    if task is None:

        raise HTTPException(
            status_code=404,
            detail="Task not found",
        )

    if task.get(
        "status"
    ) != "queued":

        raise HTTPException(
            status_code=409,
            detail=(
                f"Task cannot be claimed. "
                f"Current status: "
                f"{task.get('status')}"
            ),
        )

    if task.get(
        "device"
    ) != request.device:

        raise HTTPException(
            status_code=409,
            detail=(
                f"Task belongs to "
                f"'{task.get('device')}'."
            ),
        )

    task["status"] = "running"

    task["claimed_by"] = (
        request.device
    )

    task["claimed_at"] = (
        current_time()
    )

    task["attempt_count"] = int(task.get("attempt_count", 0)) + 1
    task["lease_id"] = str(uuid.uuid4())
    task["lease_expires_at"] = expires_at()
    task["heartbeat_at"] = current_time()
    task["recovery_reason"] = None

    save_tasks()

    return task


# ============================================================
# RENEW TASK LEASE
# ============================================================

@app.post("/tasks/{task_id}/heartbeat")
async def heartbeat_task(task_id: str, request: TaskHeartbeatRequest):
    task = tasks.get(task_id)
    if task is None:
        raise HTTPException(status_code=404, detail="Task not found")
    if task.get("status") != "running":
        raise HTTPException(status_code=409, detail="Task is not running")
    if task.get("claimed_by") != request.device or task.get("lease_id") != request.lease_id:
        raise HTTPException(status_code=409, detail="Task lease is not owned by this agent")

    task["heartbeat_at"] = current_time()
    task["lease_expires_at"] = expires_at()
    save_tasks()
    return {"task_id": task_id, "lease_expires_at": task["lease_expires_at"]}


